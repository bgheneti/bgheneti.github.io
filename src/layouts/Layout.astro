---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Get theme data from content collection
const theme = await getEntry('settings', 'theme');
const themeData = theme.data;

export interface Props {
  title?: string;
  description?: string;
  isHomePage?: boolean;
}

const { title = 'Banti Gheneti', description = themeData.site_description, isHomePage = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.png">
  <link rel="stylesheet" href="/code-highlight.css">
  <title>{title} - personal website</title>
  <meta name="description" content={description}>
</head>
<body class={themeData.dark_mode ? 'dark' : ''}>
  <div class:list={['layout', { 'sticky-header': isHomePage }]}>
    <Header />
    <slot />
    <Footer />
  </div>
</body>
</html>

<style is:global>
* {
  box-sizing: border-box;
}

body {
  /* Color system */
  --color-base: rgb(255, 255, 255);
  --color-base-1: rgb(243, 243, 243);
  --color-contrast: rgb(0, 0, 0);
  --color-contrast-1: rgb(43, 43, 43);
  --color-accent: #FF81D8;
  --color-accent-bg: rgba(255, 129, 215, 0.08);
  --color-text-muted: #555f77;
  --color-text-light: #41485a;
  
  /* Typography */
  --font-family-base: -apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-family-mono: Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace;
  --font-size-xs: 0.6rem;
  --font-size-sm: 0.8rem;
  --font-size-base: 0.9rem;
  --font-size-md: 1.1rem;
  --font-size-lg: 1.15em;
  --font-size-xl: 1.2rem;
  --font-size-2xl: 2em;
  --font-size-3xl: 3em;
  
  /* Spacing system */
  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;
  --spacing-3xl: 4rem;
  
  /* Animation */
  --animation-duration-fast: 0.15s;
  --animation-duration-base: 0.3s;
  --animation-duration-slow: 0.5s;
  --animation-duration-slower: 0.8s;
  --animation-easing: ease;
  
  /* Layout */
  --border-radius-sm: 3px;
  --border-radius-base: 4px;
  --border-radius-md: 6px;
  --container-width: 800px;
  --container-width-lg: 1200px;
  --touch-target-min: 44px;
  
  font-family: var(--font-family-base);
  margin: 0;
  padding: 0;
  font-size: 16px;
  background: var(--color-base);
  color: var(--color-contrast);
  transition: background var(--animation-duration-slow) var(--animation-easing);
}

body.dark {
  --color-base: rgb(0, 0, 0);
  --color-base-1: rgb(43, 43, 43);
  --color-contrast: rgb(255, 255, 255);
  --color-contrast-1: rgb(243, 243, 243);
}

h1 {
  letter-spacing: -0.01em;
}

.layout {
  padding: 0;
}

.layout.sticky-header {
  padding: 6rem 0 0 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

@media (min-width: 860px) {
  .container {
    padding: 0 6rem;
  }
}

a {
  color: inherit;
}

.content p {
  line-height: 1.5;
  color: var(--color-text-light);
  font-size: 16px;
  font-weight: 500;
}

.content a {
  color: var(--color-accent);
}

/* Global image defaults */
img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Exception for logo and other inline images */
img.logo,
.home-link img {
  display: inline !important;
  max-width: none;
}

/* Astro Picture component defaults */
picture {
  display: block;
}

picture img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

/* Content area images (markdown) */
.content img,
.content picture img {
  height: auto !important;
  margin: 2rem auto;
  object-fit: contain;
  max-width: min(100%, 800px); /* Limit to 800px or container width */
}

/* Image size variants for markdown content */
.content img.small,
.content picture.small img {
  max-width: min(100%, 400px);
}

.content img.medium,
.content picture.medium img {
  max-width: min(100%, 600px);
}

.content img.large,
.content picture.large img {
  max-width: min(100%, 1000px);
}

.content img.full,
.content picture.full img {
  max-width: 100%;
}

/* Float variants for wrapping text */
.content img.float-left {
  float: left;
  margin: 1rem 2rem 1rem 0;
  max-width: min(45%, 400px);
}

.content img.float-right {
  float: right;
  margin: 1rem 0 1rem 2rem;
  max-width: min(45%, 400px);
}

/* Video/iframe responsive styling */
.content iframe {
  max-width: min(100%, 800px);
  height: auto;
  aspect-ratio: 16 / 9;
  margin: 2rem auto;
  display: block;
}

/* Video size variants */
.content iframe.small {
  max-width: min(100%, 400px);
}

.content iframe.medium {
  max-width: min(100%, 600px);
}

.content iframe.large {
  max-width: min(100%, 1000px);
}

.content iframe.full {
  max-width: 100%;
}

/* Responsive video wrapper for aspect ratio */
.content .video-wrapper {
  position: relative;
  max-width: min(100%, 800px);
  margin: 2rem auto;
  aspect-ratio: 16 / 9;
}

.content .video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
}

@media (max-width: 768px) {
  .content img,
  .content picture img {
    margin: 1rem auto;
  }
  
  .content iframe {
    margin: 1rem auto;
  }
  
  /* Remove floats on mobile */
  .content img.float-left,
  .content img.float-right {
    float: none;
    margin: 1rem auto;
    max-width: 100%;
  }
}

.label {
  display: block;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

/* ===== GLOBAL ANIMATIONS ===== */
@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== SHARED UTILITY CLASSES ===== */
/* Animation utilities */
.fade-in-up {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp var(--animation-duration-slower) var(--animation-easing) forwards;
}

.staggered-1 { animation-delay: 0.1s; }
.staggered-2 { animation-delay: 0.2s; }
.staggered-3 { animation-delay: 0.3s; }
.staggered-4 { animation-delay: 0.4s; }
.staggered-5 { animation-delay: 0.5s; }
.staggered-6 { animation-delay: 0.6s; }

/* Layout utilities */
.grid-container {
  margin: var(--spacing-xl) auto;
  max-width: var(--container-width);
  padding: 0 var(--spacing-md);
}

.grid-container-lg {
  max-width: var(--container-width-lg);
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-accent { color: var(--color-accent); }
.text-muted { color: var(--color-text-muted); }
.text-light { color: var(--color-text-light); }

/* Content area text alignment utilities */
.content .center,
.content .text-center {
  text-align: center;
}

.content .left,
.content .text-left {
  text-align: left;
}

.content .right,
.content .text-right {
  text-align: right;
}

/* Interactive utilities */
.card-base {
  transition: all var(--animation-duration-base) var(--animation-easing);
  border-radius: var(--border-radius-base);
}

.hover-lift {
  transition: transform var(--animation-duration-base) var(--animation-easing);
}

.hover-scale {
  transition: transform var(--animation-duration-slow) ease-out;
}

.accent-bg {
  background: var(--color-accent-bg);
}

/* Touch-friendly interactions */
@media (max-width: 768px) {
  .nav__link {
    padding: var(--spacing-sm);
    min-height: var(--touch-target-min);
  }
  
  .card-base:active {
    background-color: rgba(0, 0, 0, 0.05);
  }
}

/* Hover states for devices that support it */
@media (hover: hover) {
  .hover-lift:hover {
    transform: translateY(-2px);
  }
  
  .hover-scale:hover {
    transform: scale(1.02);
  }
  
  .hover-accent:hover {
    color: var(--color-accent);
  }
  
  .hover-accent-bg:hover {
    background: var(--color-accent-bg);
  }
}

/* Remove sticky hover states on touch devices */
@media (hover: none) {
  .nav__link:hover,
  .project-card:hover,
  .link-link:hover {
    background: transparent;
    color: inherit;
    transform: none;
  }
}
</style>