---
import { getCollection } from 'astro:content';

// Get and sort projects by date (newest first)
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Create alternating rows: 1 item, 2 items, 1 item, 2 items...
function createAlternatingRows(projects) {
  const rows = [];
  let currentIndex = 0;
  let rowIndex = 0;

  while (currentIndex < projects.length) {
    const isSingleItemRow = rowIndex % 2 === 0; // Even rows have 1 item
    const itemsInRow = isSingleItemRow ? 1 : 2;
    const rowItems = projects.slice(currentIndex, currentIndex + itemsInRow);
    
    rows.push({ 
      items: rowItems, 
      isSingleItemRow,
      rowIndex 
    });
    
    currentIndex += itemsInRow;
    rowIndex++;
  }
  
  return rows;
}

const rows = createAlternatingRows(sortedProjects);
---

<div class="projects-container">
  {rows.map((row, rowIdx) => (
    <div class:list={[
      'project-row', 
      { 'single-item': row.isSingleItemRow, 'double-items': !row.isSingleItemRow }
    ]}>
      {row.items.map((project, itemIdx) => {
        // Calculate global index for staggered animation delays
        const globalIndex = rows.slice(0, rowIdx).reduce((acc, r) => acc + r.items.length, 0) + itemIdx;
        const animationDelay = `${(globalIndex + 1) * 0.1}s`;
        
        return (
          <article class="project-card" style={`animation-delay: ${animationDelay}`}>
            <a href={`/projects/${project.slug}`} class="project-link">
              {/* Project Thumbnail */}
              {project.data.thumbnail && (
                <img 
                  src={project.data.thumbnail} 
                  alt={project.data.title}
                  class="project-thumbnail"
                />
              )}
              
              {/* Project Information */}
              <div class="project-info">
                <h3 class="project-title">{project.data.title}</h3>
                
                <div class="project-meta">
                  {/* Categories */}
                  {project.data.categories.map((category, index) => (
                    <span class="category">
                      {category}{index < project.data.categories!.length - 1 ? ', ' : ''}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  ))}
</div>

<style>
/* ===== CONTAINER LAYOUT ===== */
.projects-container {
  margin: var(--spacing-xl) auto;
  max-width: var(--container-width);
  padding: 0 var(--spacing-md);
}

.project-row {
  display: flex;
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-md);
  justify-content: center;
}

/* ===== ROW LAYOUTS ===== */
/* Single item rows (1st, 3rd, 5th...) */
.project-row.single-item {
  justify-content: center;
}

.single-item .project-card {
  width: 100%;
  max-width: 800px;
}

/* Double item rows (2nd, 4th, 6th...) */
.project-row.double-items {
  justify-content: center;
}

.double-items .project-card {
  width: calc(50% - var(--spacing-md));
  max-width: 390px;
  flex: 1;
}

/* ===== ANIMATIONS ===== */

/* ===== PROJECT CONTENT ===== */
.project-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* Project thumbnails */
.project-thumbnail {
  width: 100%;
  height: 300px;
  object-fit: cover;
  display: block;
  transition: all var(--animation-duration-slow) ease-out;
}

/* Image scaling on hover */
@media (hover: hover) {
  .project-card:hover .project-thumbnail {
    transform: scale(1.02);
  }
}

/* Project information section */
.project-info {
  padding: 0.7rem;
  text-align: center;
}

.project-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  margin: 0 0 0.4rem 0;
  line-height: 1.3;
  transition: color var(--animation-duration-base) var(--animation-easing);
}

@media (hover: hover) {
  .project-card:hover .project-title {
    color: var(--color-accent);
  }
}

.project-card:active .project-title {
  color: var(--color-accent);
}

/* ===== PROJECT METADATA ===== */
.project-meta {
  gap: 0.4rem;
  font-size: var(--font-size-xs);
  color: var(--color-contrast-1);
}

.category {
  color: var(--color-contrast-1);
  transition: color var(--animation-duration-base) var(--animation-easing);
}

@media (hover: hover) {
  .project-card:hover .category {
    color: var(--color-contrast);
  }
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 768px) {
  .projects-container {
    max-width: 100%;
    padding: 0 1rem;
  }

  .project-row.double-items {
    flex-direction: column;
    align-items: center;
  }
  
  .project-card {
    width: 100% !important;
  }
  
  .project-thumbnail {
    height: 250px;
  }
}
</style>