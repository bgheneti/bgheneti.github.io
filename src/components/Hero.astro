---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';

// Get theme data from content collection
const theme = await getEntry('settings', 'theme');
const themeData = theme.data;

// The hero image is now properly imported through the content collection
const heroImageSrc = themeData.hero_img;
---

<div class="hero">
  <div style="width:100%">
    <div class="hero-txt">
      {heroImageSrc && (
        <Picture class="hero-img fade-in-up staggered-1 hover-lift" src={heroImageSrc} alt="Hero image" />
      )}
      {themeData.hero_content.map((item) => (
        <div class="hero-content fade-in-up staggered-2">
          <div class="hero-title-wrapper">
            <h2 class="hero-title" set:html={item.title} />
          </div>
          <p class="hero-subtitle" set:html={item.text} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
.hero {
  text-align: left;
  width: var(--container-width);
  max-width: 100%;
  margin: 0 auto;
  padding: var(--spacing-3xl) 0;
}

.hero-content {
  padding-bottom: 2em;
  overflow: hidden;
}



@media only screen and (max-width: 600px) {
  .hero-txt {
    width: 100%;
  }
  
  .hero-img {
    float: none !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 0 1rem 0 !important;
  }
  
  .hero-title-wrapper {
    float: none !important;
    display: block !important;
    margin-bottom: 1rem !important;
  }
  
  .hero-title {
    font-size: 2em !important;
    margin: 0 !important;
  }
}

.hero-title {
  font-size: var(--font-size-3xl);
  font-weight: 400;
  margin: 0 var(--spacing-sm) 0 0;
}

.hero-title-wrapper {
  margin: 0px;
  float: left;
  display: inline-block;
}

.hero-title :global(p),
.hero-subtitle :global(p) {
  margin: 0;
  padding: 0;
}

.hero-subtitle {
  font-size: var(--font-size-lg);
  font-weight: 500;
  line-height: 1.68;
  padding: 0;
  margin: 0;
  color: var(--color-text-muted);
  text-align: justify;
}

.hero-img {
  width: 45%;
  height: auto;
  float: right;
  margin-left: 30px;
  margin-bottom: var(--spacing-md);
  transition: transform var(--animation-duration-base) var(--animation-easing);
  object-fit: contain;
}

@media (hover: hover) {
  .hero-img:hover {
    transform: translateY(-4px);
  }
}

.hero-img:active {
  transform: translateY(-2px);
}

.hero-subtitle :global(a) {
  color: var(--color-accent) !important;
  text-decoration: none;
}

.hero-subtitle :global(a):hover {
  text-decoration: underline;
}

.hero-subtitle :global(p) {
  font-size: var(--font-size-lg);
  font-weight: 500;
  line-height: 1.68;
  color: var(--color-text-muted);
}
</style>