---
import themeData from '../../data/theme.json';
---

<footer class="footer">
  <div class="container">
    <p set:html={themeData.footer} />
  </div>
</footer>

<style>
.footer {
  padding: 2rem 0;
  text-align: center;
  border-top: 1px solid var(--color-base-1);
  margin-top: 4rem;
}

.footer p {
  margin: 0;
  font-size: 0.9rem;
  color: var(--color-contrast-1);
}
</style>